# ============================================================
# MeowTV Web Frontend Nginx 配置模板
#
# 占位符说明:
#   ${BACKEND_URL} - 后端 API 服务地址（运行时通过环境变量替换）
#                    默认值由 entrypoint.sh 设置为 http://backend:8088
#
# 使用方式:
#   容器启动时，entrypoint.sh 会用 BACKEND_URL 环境变量的值
#   替换 ${BACKEND_URL} 占位符，生成最终的 nginx.conf
# ============================================================

server {
    listen 80;
    server_name _;

    # 安全头
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Gzip 压缩
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml;

    # 静态资源目录
    root /usr/share/nginx/html;
    index index.html;

    # 静态资源缓存（Vite 构建产物带 hash，无缓存破坏问题）
    location ~* \.(js|css|woff2?|ttf|eot|map)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # 图片资源缓存
    location ~* \.(png|jpg|jpeg|gif|ico|webp|svg)$ {
        expires 6M;
        add_header Cache-Control "public";
        access_log off;
    }

    # HTML 不缓存（确保用户获取最新版本）
    location ~* \.html$ {
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # API 请求反向代理到后端
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # SPA 路由回退：所有非文件请求返回 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 禁止访问隐藏文件
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
