<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Uncomment keychain-access-groups when using a Developer certificate for signing.
	     This is required by flutter_secure_storage on macOS to access the Keychain.
	     When using ad-hoc signing (CODE_SIGN_IDENTITY = "-"), keep this commented out. -->
	<!--
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.meowtv.meowtvMobile</string>
	</array>
	-->
</dict>
</plist>
